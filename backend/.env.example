CREATE_TABLES_ON_STARTUP="false"
BIM_ENABLED="false"
BIM_ALLOWED_EMPRESA_IDS=""
BIM_ALLOWED_USER_IDS=""

# Email transaccional real para validacion de registro publico.
# Con EMAIL_BACKEND="mock" no se enviaran correos reales.
EMAIL_BACKEND="smtp"
EMAIL_FROM_EMAIL="soporte@giproy.com"
EMAIL_FROM_NAME="GiProy"
FRONTEND_PUBLIC_URL="https://giproy-network.excompc.dpdns.org"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
