PROJECT_NAME="GIPROY ERP"
API_V1_STR="/api/v1"
SECRET_KEY="change-this-in-env"
RUC_REVIEW_ENCRYPTION_KEY="set-a-dedicated-random-secret"
SRI_RUC_PRIVATE_DIR="runtime/sri_ruc"
SRI_RUC_LOOKUPS_PER_IP_HOUR=10
SRI_RUC_ALERT_EMAIL=""
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
