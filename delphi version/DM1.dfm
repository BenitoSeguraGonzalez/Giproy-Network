  object QuComunicacion: TUniQuery
    Connection = con2
    SQL.Strings = (
      'SELECT'
      '  id,'
      '  graficoImagen,'
      '  receptor,'
      '  tipoDescripcion,'
      '  fechahoraEmision,'
      '  fechahoraRecepcion,'
      '  idUsuarioReceptor,'
      '  idUsuarioEmisor,'
      '  idExterno,'
      '  idTipoComunicacion,'
      '  datoscomunicacion,'
      '  graficoDescripcion'
      'FROM ('
      '  -- Primer bloque corregido'
      '  SELECT * FROM ('
      '    SELECT'
      '      u.id,'
      '      g.imagen AS graficoImagen,'
      '      u.receptor,'
      '      ut.descripcion AS tipoDescripcion,'
      '      u.fechahoraEmision,'
      '      u.fechahoraRecepcion,'
      '      u.idUsuarioEmisor,'
      '      u.idUsuarioReceptor,'
      '      u.idExterno,'
      '      u.idTipoComunicacion,'
      '      u.datoscomunicacion,'
      '      g.descripcion AS graficoDescripcion,'
      '      1 as orden'
      '    FROM usuario_comunicacion u'
      
        '    INNER JOIN usuario_tipocomunicacion ut ON ut.id = u.idTipoCo' +
        'municacion'
      
        '    LEFT JOIN graficos g ON g.idTipoComunicacion = u.idTipoComun' +
        'icacion'
      '    WHERE u.idTipoComunicacion = 1'
      '      AND u.idUsuarioReceptor = :p_idUsuario'
      '    ORDER BY u.fechahoraEmision ASC'
      '    LIMIT 1'
      '  ) AS bloque1'
      ''
      '  UNION ALL'
      ''
      '  -- Segundo bloque - Solo registros de los '#250'ltimos 3 d'#237'as'
      '  SELECT'
      '    u.id,'
      '    g.imagen AS graficoImagen,'
      '    u.receptor,'
      '    ut.descripcion AS tipoDescripcion,'
      '    u.fechahoraEmision,'
      '    u.fechahoraRecepcion,'
      '    u.idUsuarioEmisor,'
      '    u.idUsuarioReceptor,'
      '    u.idExterno,'
      '    u.idTipoComunicacion,'
      '    u.datoscomunicacion,'
      '    g.descripcion AS graficoDescripcion,'
      '    2 as orden'
      '  FROM usuario_comunicacion u'
      
        '  INNER JOIN usuario_tipocomunicacion ut ON ut.id = u.idTipoComu' +
        'nicacion'
      
        '  LEFT JOIN graficos g ON g.idTipoComunicacion = u.idTipoComunic' +
        'acion'
      '  WHERE u.idTipoComunicacion IN (3,7)'
      '    AND u.idUsuarioReceptor = :p_idUsuario'
      
        '    AND u.fechahoraEmision >= DATE_SUB(CURDATE(), INTERVAL 3 DAY' +
        ')'
      ''
      '  UNION ALL'
      ''
      '  -- Tercer bloque'
      '  SELECT'
      '    u.id,'
      '    g.imagen AS graficoImagen,'
      '    u.receptor,'
      '    ut.descripcion AS tipoDescripcion,'
      '    u.fechahoraEmision,'
      '    u.fechahoraRecepcion,'
      '    u.idUsuarioEmisor,'
      '    u.idUsuarioReceptor,'
      '    u.idExterno,'
      '    u.idTipoComunicacion,'
      '    u.datoscomunicacion,'
      '    g.descripcion AS graficoDescripcion,'
      '    3 as orden'
      '  FROM usuario_comunicacion u'
      
        '  INNER JOIN usuario_tipocomunicacion ut ON ut.id = u.idTipoComu' +
        'nicacion'
      
        '  LEFT JOIN graficos g ON g.idTipoComunicacion = u.idTipoComunic' +
        'acion'
      '  WHERE u.idTipoComunicacion IN (2,4)'
      '    AND u.idUsuarioReceptor = :p_idUsuario'
      ') AS combined_results'
      'ORDER BY fechahoraEmision ASC;'
      '')
    Left = 850
    Top = 770
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'p_idUsuario'
        Value = nil
      end>
    object QuComunicacionid: TLargeintField
      FieldName = 'id'
      ReadOnly = True
      Required = True
    end
