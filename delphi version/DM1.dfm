  object QAPU: TUniQuery
    Connection = con2
    SQL.Strings = (
      'SELECT'
      '  ap.descripcion descripcionAPU,'
      '  ap.Unidad AS UnidadAPU,'
      '  ai.CodCategoria,'
      '  ai.Descripcion,'
      '  ai.unidad,'
      '  ai.CantidadUnidad AS Cantidad,'
      '  ai.rendimiento,'
      '  ai.Precio,'
      '  ai.cantidadUnidad * ai.Precio AS CostoHora,'
      '  ai.Total,'
      '  ai.codCPC,'
      '  ai.TipoCPC,'
      'IF'
      
        '  (ai.codcpc IS NOT NULL, ap.CostoDirectoTotal, - 1) AS CostoDir' +
        'ectoTotal,'
      'IF'
      
        '  (ai.codcpc IS NOT NULL, ai.total / ap.CostoDirectoTotal * 100,' +
        '- 1) AS pesoRelativo,'
      'IF'
      '  (ai.codcpc IS NOT NULL, ai.porcentajeCPC, - 1) AS VAER,'
      'IF'
      '  ('
      '    ai.codcpc IS NOT NULL,'
      
        '    ((ai.total / ap.CostoDirectoTotal * 100) * ai.porcentajeCPC)' +
        ' / 100,'
      '  - 1) AS PtotalVAER'
      'FROM'
      '  apus_items ai'
      '  INNER JOIN apus ap ON ap.codBase = ai.codBase'
      '  AND ap.CodAPU = ai.CodAPU'
      'WHERE'
      '  ai.codbase = :codBase    '
      '  AND ai.CodAPU = :codApu'
      '  ORDER BY CodCategoria')
    Left = 1416
    Top = 444
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codBase'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'codApu'
        Value = nil
      end>
