  object QIndicesFormulaPolinomica: TUniQuery
    Connection = con2
    SQL.Strings = (
      'SELECT  '
      '  findice.descripcion,'
      '  findice.termino as terminoRecurso,'
      '  IFNULL('
      '    ('
      '      SELECT'
      '        Redondea (sum(precurso.total), 3)'
      '      FROM'
      '        presupuestos_recursos precurso'
      '      WHERE'
      '        precurso.codBase = findice.codBase'
      '        AND precurso.codPresupuesto = findice.codpresupuesto'
      '        AND precurso.revision = findice.revision'
      '    AND precurso.termino = findice.termino),'
      '  0) AS SubtotalTermino'
      'FROM'
      '  presupuestos_indicesseleccionados findice'
      'WHERE'
      '  findice.codbase = :codbase'
      ''
      '  AND findice.codPresupuesto = :codPresupuesto'
      ''
      '  AND findice.revision = :revision')
    Left = 1404
    Top = 636
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codbase'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'codPresupuesto'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'revision'
        Value = nil
      end>
    object QIndicesFormulaPolinomicadescripcion: TStringField
      FieldName = 'descripcion'
      Size = 255
    end
    object QIndicesFormulaPolinomicaterminoRecurso: TStringField
      FieldName = 'terminoRecurso'
      Size = 255
    end
    object QIndicesFormulaPolinomicaSubtotalTermino: TFloatField
      FieldName = 'SubtotalTermino'
      ReadOnly = True
      Required = True
    end
  end
  object QDatosGeneralesPresupuesto: TUniQuery
