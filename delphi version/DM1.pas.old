procedure AbrirImagenConVisor();
var
  imagenReferenciaProyecto: string;
begin
  imagenReferenciaProyecto := dirImagenReferencia + base_activa.codBase +
    codProyecto + '.jpg';
  if not FileExists(imagenReferenciaProyecto) then
  begin
    imagenReferenciaProyecto := dirImagenReferencia + base_activa.codBase +
      codProyecto + '.png';
