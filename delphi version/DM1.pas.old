        Close;
        SQL.Clear;
        { (* }
        SQLstring := 'SELECT ' + '  count(codAPU) AS Datos ' + 'FROM ' +
          '  presupuestos_tanteo_apus ' + 'WHERE ' + '  codBase = :codBase ' +
          '  AND codPresupuesto = :codPresupuesto ' +
