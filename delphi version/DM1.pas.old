/// <summary>
/// Implementa la lógica principal de ajustaPorcentajeItems.
/// </summary>
procedure ajustaPorcentajeItems(totalTanteo: Double; modo: Integer);
var
  nodo: TTMSFNCTreeViewNode;
  sumaResilente: Double;
  valorSubtotal: Double;
  valorPorcentaje: Double;
begin
  case modo of
    1:
      begin
        nodo := frmMain.Trvw_APUSTanteo.Nodes[0];
      end;
    2:
      begin
        nodo := frmMain.Trvw_TanteoCrono.Nodes[0];
      end;
  end;

  sumaResilente := 0;
  while Assigned(nodo) do
  begin
    if nodo.Text[6] <> '' then
    begin
      valorSubtotal := quitaFormatFloat(nodo.Text[6]);
      valorPorcentaje := (100 * valorSubtotal) / totalTanteo;
      sumaResilente := sumaResilente + valorPorcentaje;
      nodo.Text[7] := FloatToStr(valorPorcentaje) + ' %';
    end;
    nodo := nodo.GetNext;
  end;
  nodo := frmMain.Trvw_APUSTanteo.GetLastNode;
  sumaResilente := 100 - sumaResilente;
  if sumaResilente > 0 then
  begin
    valorPorcentaje := SafeStrToFloat(ReplaceStr(nodo.Text[7], ' %', ''));
    valorPorcentaje := valorPorcentaje + sumaResilente;
    nodo.Text[7] := FloatToStr(valorPorcentaje) + ' %';
  end;
end;

procedure actualizaDerivacion(LForm: Tfrm_CronoDerivaciones);
var
  x, Y: Integer;
  tmpstr: string;
  valor: Double;
  rowInicio, rowFin: Integer;
  salir: Boolean;
  nperiodos: Integer;
  itemInicio, IntemFinal: Integer;
  rowindex: Integer;
  entrar: Boolean;
  tFaltaDerivacion: Integer;
begin
  valor := 0;
  entrar := True;
  nperiodos := StrToInt(frmMain.lbl_cronogramaNPeriodos.Text);
  derivacionPresupuesto := TStringList.Create;

  if frm_CronoDerivaciones.Visible then
  begin
    for x := 0 to LForm.grid_DefDerivacion.columns.Count - 1 do
    begin
      tmpstr := LForm.grid_DefDerivacion.cells[x, 1];
      if tmpstr <> '' then
      begin
        tmpstr := ReplaceStr(tmpstr, '%', '');
        derivacionPresupuesto.Add(tmpstr);
        valor := valor + strtofloat(tmpstr);
      end;
    end;

    if entrar then
    begin
      if valor <> 100 then
      begin
        ShowMessage('No esta Asignado la totalidad del Porcentaje.')
      end
      else
      begin
        tmpstr := derivacionPresupuesto.Text;
        frmMain.grid_crono0.columns[11].width := 0;
        case ModoCronoDerivaciones of
          0: // en Todo el cronograma
            begin
              for x := 1 to frmMain.grid_crono0.RowCount - 1 do
              begin
                frmMain.grid_crono0.cells[11, x] := tmpstr;
              end;
            end;
          1: // solo en la lineas seleccionadas
            begin
              for x := 0 to frmMain.grid_crono0.RowSelectionCount - 1 do
              begin
                rowindex := frmMain.grid_crono0.SelectedRow[x];
                if frmMain.grid_crono0.cells[0, rowindex] = '' then
                  frmMain.grid_crono0.cells[11, rowindex] := tmpstr;
              end;
            end;
          2: // Solo en la EDT seleccionada
            begin
              x := frmMain.grid_crono0.Selection.StartRow;
              salir := False;
              while (not salir) and (x < frmMain.grid_crono0.RowCount) do
              begin
                if frmMain.grid_crono0.cells[0, x] <> '' then
                begin
                  frmMain.grid_crono0.cells[11, x] := tmpstr;
                end
                else
                begin
                  salir := True;
                end;
                Inc(x);
              end;
            end;
        end;
      end;
    end;
  end;
end;

/// <summary>TODO: Descripción de ejecutaCronoDerivaciones.</summary>
procedure ejecutaCronoDerivaciones();
var
  derivacionCompleta: Integer;
  LForm: Tfrm_CronoDerivaciones;
begin
  LForm := Tfrm_CronoDerivaciones.Create(Application);
  try
    LForm.grid_DefDerivacion.StopEdit;
    actualizaDerivacion(LForm);
    guardarDatosDerivacion;
    derivacionCompleta := faltaDatosDerivacion;
    if cantidadCronoDerivaciones > 0 then
    begin
      limpiagridCrono(frmMain.grid_Crono1);
      calcularPorCentajeEjecucionObras(); // crono1
      limpiagridCrono(frmMain.grid_Crono2);
      limpiagridCrono(frmMain.grid_CronoTotales);
      calcularInversion(); // crono2   y Gbarras
      limpiagridCrono(frmMain.grid_Crono3);
      calcularCantidadesObras(); // crono3
      frmMain.tbc1.ActiveTab := frmMain.tab_1;
      frmMain.grid_Crono1.SetFocus;
      SeleccionaTabCrono(1);
      cancelarDerivacion := frmMain.cbb_cronoTipoPeriodo.Items
        [frmMain.cbb_cronoTipoPeriodo.itemindex] + ',' +
      frmMain.lbl_cronogramaNPeriodos.Text;
      if derivacionCompleta = 0 then
        AjustaCurvaS();
      sincronizaTamanoGrid(frmMain.grid_Crono1, frmMain.grid_CronoTotales);
      sincronizaTamanoGrid(frmMain.grid_Crono1, frmMain.grid_Crono2);
      sincronizaTamanoGrid(frmMain.grid_Crono1, frmMain.grid_Crono3);
      sincronizaTamanoGrid(frmMain.grid_Crono1, frmMain.grid_GBarras);
      frmMain.grid_CronoTotales.ColumnCount :=
        frmMain.grid_CronoTotales.ColumnCount - 1;
    end;
  finally
    LForm.Free;
  end;
end;

