/// <summary>TODO: Descripción de contieneTanteos.</summary>
procedure contieneTanteos();

var
  qry: TUniQuery;
begin
  contieneTanteo := False;
  qry := TUniQuery.Create(nil);
  try
    with qry do
    begin
      Connection := DModule_1.con2;
      Close;
      SQL.Clear;
      { (* }
      SQL.Add('select codBase ' + '  from presupuestos_tanteo_Apus ' +
