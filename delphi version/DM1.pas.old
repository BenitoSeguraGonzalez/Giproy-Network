      ParamByName('codBase').AsString := codBaseTratar;
      ParamByName('codPresupuesto').AsString := codPresupuesto;
      Prepare;
      Open;
      while not Eof do
      begin
        tmpstr := FieldByName('revision').AsString;
        tmplst.Add(tmpstr);
        Next;
      end;
    end;
  finally
    qry.Free;
  end;
  Result := tmplst;
end;

