/// <summary>
/// Implementa la lógica principal de generaCodigoUnico.
/// </summary>
function generaCodigoUnico(): string;

var
  datos: string;
  test: Integer;
begin
  test := Random($7FFFFFFF);
  datos := FormatDateTime('yyyymmddhhnnss', Now);
  Result := IntToStr(test) + datos;
end;

