/// <summary>
/// Implementa la lógica principal de IsAlphaNumeric.
/// </summary>
function IsAlphaNumeric(C: Char): Boolean;
begin
  Result := CharInSet(C, ['a'..'z', 'A'..'Z', '0'..'9']);
end;

