procedure EndGuardarAPU;
var
  Q: TUniQuery;
begin
  Q := TUniQuery.Create(nil);
  try
    Q.Connection := DModule_1.con2;
    Q.SQL.Text := 'SET @apu_guardando = NULL';
    Q.ExecSQL;
  finally
