procedure limpiaGridRecursos();
begin
  frmMain.grid_Recursos.ClearNormalCells;
  frmMain.grid_Recursos.RowCount := 1;
  frmMain.grid_Recursos.cells[1, 0] := 'Código';
  frmMain.grid_Recursos.cells[2, 0] := 'Descripción';
