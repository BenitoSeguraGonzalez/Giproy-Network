      ParamByName('codbase').AsString := base_activa.codBase;
      ParamByName('codPresupuesto').AsString := codProyecto;
      ParamByName('revision').AsString := revision;
      Prepare;
      Open;
      Result := FieldByName('NDerivacion').AsInteger;
    end;
  finally
