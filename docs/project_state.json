  "ai_tooling": {
    "snapshots": [
      {
        "path": "docs/repo_hygiene_inventory.json",
        "generator": "tools/ai_tools/repo_hygiene_inventory.py",
        "purpose": "Clasificar artefactos sensibles, generados, scripts sueltos y assets/pruebas para evitar limpiezas destructivas."
      },
      {
        "path": "docs/logging_inventory.json",
        "generator": "tools/ai_tools/logging_inventory.py",
        "purpose": "Inventariar print(), logger.*, console.* y salidas PowerShell con terminos sensibles heurísticos antes de micro-refactors de logging."
      }
    ],
    "baseline_validator": {
      "path": "tools/ai_tools/validate_enterprise_baseline.py",
      "covers": [
        "JSON documentales",
        "compileall backend/app",
        "import app.main",
        "npm run build con --include-frontend",
        "smoke classic no-BIM con --include-frontend"
      ]
    }
  },
  "validation_policy": {
    "backend": [
      "py_compile focal sobre archivos tocados",
      "pytest focal por modulo",
      "no migraciones destructivas",
      "auth y tenant deben conservarse"
    ],
    "frontend": [
      "npm run build",
      "smoke-classic-no-bim-contamination",
      "validar rutas y componentes tocados"
    ],
    "bim": [
      "no activar UX BIM durante trabajo clasico",
      "feature flag apagable",
      "sin dependencia desde componentes clasicos"
    ]
